{
  "name": "chain-sentinel-windmill-impl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "node --test",
    "check": "bun build f/chain_sentinel/scripts/destinations/*.ts f/*/lib/*.ts --root . --target=bun --external windmill-client --outdir=/tmp/chain-sentinel-windmill-build && wmill lint . --fail-on-warn --locks-required"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/emscripten": "1.41.6",
    "bun-types": "^1.4.0",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2",
    "windmill-client": "^1.800.0"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "fast-json-patch": "3.1.1",
    "handlebars": "4.7.10",
    "viem": "2.57.4"
  }
}
